ELNINO_SITE_NAME=El Niño Explained
ELNINO_INITIATIVE=Sriram Advisory
ELNINO_FEEDBACK_URL=mailto:sriram@sriramadvisory.com
# Set before public launch; names are shown on /sources.
ENSO_OPERATIONAL_OWNER=
ENSO_CONTENT_REVIEWER=
# Daily 06:00 UTC refresh in a continuously running Node deployment.
# Disable when scheduling `npm run data:refresh` externally instead.
ENSO_AUTO_REFRESH=1
# Optional absolute paths on persistent storage, in separate backup locations.
# ENSO_DATA_DIR=D:/sriram/ElNinoTracker/.enso-data
# ENSO_RECOVERY_DIR=D:/sriram/ElNinoTracker/.enso-recovery
# Approval identity for CLI manual import and rollback only; no public write API.
# APPROVAL_IDENTITY=
