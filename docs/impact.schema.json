{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed impact content",
  "type": "object",
  "required": [
    "content_version",
    "provider",
    "source_checked_at",
    "review_state",
    "cards"
  ],
  "properties": {
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "region",
          "phase",
          "evidence_type",
          "title",
          "text",
          "official_url",
          "applicable_months",
          "review_state"
        ],
        "properties": {
          "region": {
            "enum": [
              "india",
              "global"
            ]
          },
          "evidence_type": {
            "enum": [
              "source_link",
              "typical_pattern",
              "official_outlook",
              "official_guidance"
            ]
          },
          "phase": {
            "enum": [
              "all",
              "el_nino",
              "la_nina",
              "neutral",
              "unknown"
            ]
          },
          "official_url": {
            "type": "string",
            "format": "uri"
          },
          "applicable_months": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "review_state": {
            "enum": [
              "pending",
              "approved",
              "source_verified"
            ]
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_due_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "highlight": {
            "type": "string"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "topic": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    }
  }
}
